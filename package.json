{
  "name": "smartscale-global-scraper",
  "version": "0.1.0",
  "description": "SmartScale Global desktop scraper app - Phase 1 (accounts & shell)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build:renderer": "vite build",
    "build:protected": "npm run build:renderer && node scripts/obfuscate.js",
    "start": "electron .",
    "test": "node tests/engine-helpers.test.cjs && node tests/queue-backups.test.cjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mantine/core": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@napi-rs/keyring": "^1.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tabler/icons-react": "^3.46.0",
    "adm-zip": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "javascript-obfuscator": "^5.5.0",
    "vite": "^5.4.6",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
